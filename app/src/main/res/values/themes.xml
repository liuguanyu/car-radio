<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.CarRadio" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_variant</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/status_bar</item>
        <!-- Customize your theme here. -->
        <item name="android:windowBackground">@color/background</item>
        <item name="android:navigationBarColor">@color/navigation_bar</item>
    </style>

    <!-- Splash screen theme -->
    <style name="Theme.CarRadio.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_radio</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
        <item name="postSplashScreenTheme">@style/Theme.CarRadio</item>
    </style>

    <!-- Fullscreen theme for player -->
    <style name="Theme.CarRadio.Fullscreen" parent="Theme.CarRadio">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <!-- Car mode theme -->
    <style name="Theme.CarRadio.CarMode" parent="Theme.CarRadio">
        <item name="android:windowBackground">@color/car_background</item>
        <item name="colorPrimary">@color/car_primary</item>
        <item name="android:textColorPrimary">@color/car_text</item>
        <item name="android:textColorSecondary">@color/car_text</item>
    </style>

</resources>