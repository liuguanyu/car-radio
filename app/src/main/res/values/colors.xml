<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 主色：车载推荐紫色 -->
    <color name="primary">#FF6200EE</color>
    <color name="primary_dark">#FF3700B3</color>
    <color name="primary_variant">#FF3700B3</color>
    <color name="secondary">#FF03DAC6</color>
    <color name="secondary_variant">#FF018786</color>

    <!-- 车载核心：全部使用深色背景 -->
    <color name="background">#FF121212</color>
    <color name="background_secondary">#FF1E1E1E</color>
    <color name="splash_background">#FF121212</color>

    <!-- 车载核心：文字必须白色/浅灰 -->
    <color name="text_primary">#FFFFFFFF</color>
    <color name="text_secondary">#FFB3B3B3</color>
    <color name="text_disabled">#FF666666</color>

    <color name="white">#FFFFFFFF</color>
    <color name="black">#FF000000</color>

    <!-- 状态栏和导航栏 -->
    <color name="status_bar">@color/background</color>
    <color name="navigation_bar">@color/background</color>

    <!-- 车载配色 -->
    <color name="car_background">@color/background</color>
    <color name="car_primary">@color/primary</color>
    <color name="car_text">@color/text_primary</color>
    <color name="car_button">#FF2A2A2A</color>

    <!-- 播放器配色 -->
    <color name="player_background">#FF121212</color>
    <color name="player_controls">@color/white</color>

    <!-- 状态色 -->
    <color name="favorite">#FFFFEB3B</color>
    <color name="error">#FFCF6679</color>
    <color name="success">#FF81C99A</color>
    <color name="warning">#FFFFB74D</color>

    <!-- 分割线 -->
    <color name="divider">#FF333333</color>

    <!-- 图标 -->
    <color name="icon_default">#FFB3B3B3</color>
    <color name="icon_active">@color/primary</color>

</resources>