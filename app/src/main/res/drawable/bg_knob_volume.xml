<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer shadow ring -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#FF0A0A0A" />
            <size android:width="120dp" android:height="120dp" />
        </shape>
    </item>
    <!-- Metallic outer ring with knurl texture -->
    <item android:top="1dp" android:bottom="1dp" android:left="1dp" android:right="1dp">
        <shape android:shape="oval">
            <gradient
                android:type="sweep"
                android:startColor="#FF555555"
                android:centerColor="#FF777777"
                android:endColor="#FF555555" />
            <stroke android:width="2dp" android:color="#FF3A3A3A" />
        </shape>
    </item>
    <!-- Knurl pattern ring (simulated) -->
    <item android:top="4dp" android:bottom="4dp" android:left="4dp" android:right="4dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="56dp"
                android:startColor="#FF5A5A5A"
                android:endColor="#FF3A3A3A" />
            <stroke android:width="1dp" android:color="#FF4A4A4A" />
        </shape>
    </item>
    <!-- Main knob body with 3D gradient -->
    <item android:top="10dp" android:bottom="10dp" android:left="10dp" android:right="10dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="50dp"
                android:startColor="#FF505050"
                android:centerColor="#FF333333"
                android:endColor="#FF1E1E1E" />
            <stroke android:width="0.5dp" android:color="#FF5A5A5A" />
        </shape>
    </item>
    <!-- Top highlight (specular) -->
    <item android:top="14dp" android:bottom="30dp" android:left="14dp" android:right="30dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="30dp"
                android:startColor="#18FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
    <!-- Indicator line (pointer mark) -->
    <item android:top="12dp" android:bottom="80dp" android:left="55dp" android:right="55dp">
        <shape android:shape="rectangle">
            <solid android:color="#FF42E2B8" />
            <corners android:radius="1dp" />
        </shape>
    </item>
</layer-list>
